# Copy to deploy/hostinger/.env on your Hostinger VPS and fill in values.

# Public site URL (no trailing slash)
APP_URL=https://mockcertify.com
DOMAIN=mockcertify.com

# Neon or Hostinger PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# API secrets (generate: openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_PASSWORD=Admin123!@#

# Must match APP_URL for cookies and OAuth redirects
CLIENT_URL=https://mockcertify.com
ALLOWED_ORIGINS=https://mockcertify.com,https://www.mockcertify.com

# Set false after first successful deploy (DB already has 8k questions)
RUN_DB_IMPORT=false

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://mockcertify.com/api/v1/auth/google/callback
GOOGLE_OAUTH_ENABLED=false
