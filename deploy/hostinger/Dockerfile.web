FROM node:20-bookworm-slim AS builder
WORKDIR /app
ARG NEXT_PUBLIC_APP_URL=https://mockcertify.com
ENV HOSTINGER_BUILD=1
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --prod=false --frozen-lockfile || pnpm install --prod=false
RUN pnpm --filter @certprep/shared build
RUN pnpm --filter @certprep/web build

FROM node:20-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
